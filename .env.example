# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_EDGE_FUNCTION_URL=https://<your-project>.functions.supabase.co

# ===== Anthropic =====
ANTHROPIC_API_KEY=<anthropic-key>
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_DAILY_CALL_LIMIT=200

# ===== Crawler =====
CRAWLER_USER_AGENT=ActuarialIntelKR/1.0 (+https://actuarial-intel.kr; contact:contact@actuarial-intel.kr)

# ===== Discovery (M2~) =====
DISCOVERY_DEFAULT_SCHEDULE=0 0 * * 1
DISCOVERY_MAX_NEW_PER_RUN=20

# ===== Member Submission Channels =====
SUBMISSION_CONTACT_EMAIL=submit@actuarial-intel.kr
SUBMISSION_FORM_URL=https://forms.gle/<your-form-id>

# ===== Auth =====
MEMBER_DOMAIN_WHITELIST=samsunglife.com,hanwhalife.com,kyobo.co.kr,kiri.or.kr,fss.or.kr,actuary.or.kr

# ===== Backup =====
BACKUP_GITHUB_PAT=<pat>
BACKUP_GITHUB_REPO=tkleen/aik-backup

# ===== Site =====
NEXT_PUBLIC_SITE_URL=https://actuarial-intel.kr
NEXT_PUBLIC_ANALYTICS_ENABLED=true
